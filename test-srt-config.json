{
  "filesystem": {
    "denyRead": ["~"],
    "allowRead": [
      "/Users/spencer/.local/bin",
      "/Users/spencer/.local/lib",
      "/Users/spencer/.gitconfig",
      "/Users/spencer/.gitignore",
      "/Users/spencer/.cargo",
      "/Users/spencer/.rustup"
    ],
    "allowWrite": ["/Users/spencer/.cargo", "/Users/spencer/.rustup"],
    "denyWrite": ["/Users/spencer/.gitconfig", "/Users/spencer/.gitignore"]
  },
  "network": {
    "allowedDomains": [
      "github.com",
      "*.github.com",
      "lfs.github.com",
      "api.github.com",
      "npmjs.org",
      "*.npmjs.org"
    ],
    "deniedDomains": ["malicious.com"],
    "allowUnixSockets": ["/var/run/docker.sock"],
    "allowLocalBinding": false
  }
}
